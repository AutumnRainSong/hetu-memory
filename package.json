{
  "name": "hetu-memory",
  "version": "0.1.0",
  "description": "河图 HeTu — 跨框架通用 Agent 记忆模块（本地优先，数据归用户）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "migrate": "node --experimental-strip-types src/storage/migrate.ts",
    "schema:check": "node scripts/validate-luoshu.mjs",
    "typecheck": "tsc -p tsconfig.typetest.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}